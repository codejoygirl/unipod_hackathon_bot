# Zak AI service — local env
# Copy: Copy-Item .env.example .env   (or cp .env.example .env)

SERVICE_NAME=zak-ai
ENVIRONMENT=development
DEBUG=true

# Same Sail Postgres as Laravel (host port 5432).
# From WSL/Windows host use 127.0.0.1 — NOT "pgsql" (that hostname only works inside Sail containers).
# Same DB name/user/password as backend/.env.example (DB_DATABASE / DB_USERNAME / DB_PASSWORD).
DATABASE_URL=postgresql+psycopg://sail:password@127.0.0.1:5432/zak

# Must match backend INTERNAL_HMAC_SECRET (Laravel → AI service auth)
INTERNAL_HMAC_SECRET=prod_secure_hmac_secret_key_minimum_32_bytes_entropy
HMAC_TIMESTAMP_TOLERANCE_SECONDS=300

DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Provider keys (leave empty to use mocks / fail closed per route)
OPENAI_API_KEY=
GEMINI_API_KEY=
COHERE_API_KEY=
ANTHROPIC_API_KEY=

EMBEDDING_MODEL_NAME=text-embedding-3-small
EMBEDDING_DIMENSION=1536
CHAT_MODEL_NAME=gpt-4o-mini
RERANKER_MODEL_NAME=rerank-v3.5
