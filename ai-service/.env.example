APP_NAME=Zak
APP_ENV=local
LOG_LEVEL=info

HOST=0.0.0.0
PORT=8001

# SQLAlchemy / Alembic (restricted DB role in production)
DATABASE_URL=postgresql+psycopg://community:community@127.0.0.1:5432/community_assistant

# Shared secret for Laravel → AI HMAC (set a strong value before Phase 2)
AI_SERVICE_SHARED_SECRET=

# Providers are configured separately (do not use a single AI_MODEL for everything)
AI_CHAT_PROVIDER=mock
AI_CHAT_MODEL=mock-chat
AI_EMBEDDING_PROVIDER=mock
AI_EMBEDDING_MODEL=mock-embedding
AI_RERANK_PROVIDER=mock
AI_RERANK_MODEL=mock-rerank
AI_TRANSCRIPTION_PROVIDER=mock
AI_TRANSCRIPTION_MODEL=mock-transcription
AI_TRANSLATION_PROVIDER=mock
AI_TRANSLATION_MODEL=mock-translation
AI_FALLBACK_PROVIDER=mock

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
