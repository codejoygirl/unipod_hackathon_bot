# WhatsApp Web automation spike — copy to .env
# NEVER commit real session folders or production secrets.

# Laravel API (Sail default)
LARAVEL_BASE_URL=http://localhost
SPIKE_SECRET=change-me-to-a-long-random-string

# Optional: only forward private chats from the sidecar (default true).
# Set false to forward groups; Laravel applies WHATSAPP_WEB_SPIKE_GROUP_LISTEN.
PRIVATE_CHATS_ONLY=true

# Seed bot identity for group @mentions (match backend WHATSAPP_WEB_SPIKE_BOT_*).
# BOT_LID=100696296808461
# BOT_NUMBER=2347041131371
# BOT_USERNAME=unipod_bot
# BOT_ALIASES=zak_bot

# Temporary: verbose settle / swipe-quote tracing (quoted=true/false honesty)
# SPIKE_DEBUG=true

# Headless Chrome often connects but never receives DMs on Windows.
# Default is false (visible Chrome). Set true only if you need headless.
HEADLESS=false

# Laravel → spike outbound (admin escalation DMs). POST /send
OUTBOUND_PORT=3101

# Optional: only pin a WA Web HTML if you must. Leave unset (recommended).
# A stale pin makes the spike hang forever with ready=false.
# Do NOT set WEB_VERSION unless you know you need it.
# WEB_VERSION=2.3000.1048032155
# WEB_VERSION_HTML=https://raw.githubusercontent.com/wppconnect-team/wa-version/main/html/2.3000.XXXXX.html

# If ready=false / logout loop on Windows:
#   npm run kill-chrome
#   npm start
# Full reset (new QR):
#   npm run fresh
