# Telegram Bot spike — copy to .env (never commit real tokens)

LARAVEL_BASE_URL=http://localhost
SPIKE_SECRET=change-me-to-match-TELEGRAM_SPIKE_SECRET

# From @BotFather
TELEGRAM_BOT_TOKEN=

# Optional reply language passed to Laravel ask
TARGET_LANGUAGE=en

# plain (default): no raw asterisks. html: bold via Telegram parse_mode=HTML
TELEGRAM_PARSE_MODE=plain
