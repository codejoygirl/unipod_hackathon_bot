APP_NAME=Zak
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Sail serves the API on host port 80 by default (APP_PORT)
APP_URL=http://localhost
# IANA timezone for relative dates in grounded answers (e.g. Africa/Lagos, Africa/Cairo)
APP_TIMEZONE=UTC
# Same host as APP_URL when the Next export is synced to public/ (npm run build:laravel).
FRONTEND_URL=http://localhost
# Bot name in member/admin chat copy (intros, help, escalation cards)
ZAK_BOT_DISPLAY_NAME="Zak Bot"
ZAK_SHOW_WEB_CHAT=true
ZAK_WEB_CHAT_URL="${FRONTEND_URL}"
ZAK_WEB_CHAT_LABEL="Web chat"
# Web chat: URL is /?phone=<digits>; community from DEFAULT_COMMUNITY_ID below.
ZAK_WEB_CHAT_ENABLED=true
ZAK_WEB_CHAT_DEFAULT_COMMUNITY_ID=
ZAK_WEB_CHAT_ACTOR_USER_EMAIL="${WHATSAPP_ZAVU_DEFAULT_USER_EMAIL}"
# Optional legacy admin mint keys (not used in member URLs):
# ZAK_WEB_CHAT_ACCESS_KEY=
# ZAK_WEB_CHAT_ACCESS_KEY_TTL_HOURS=720
# Optional public Telegram bot handle → builds https://t.me/<handle>
# Example: zak_meti_26_bot
ZAK_TELEGRAM_HANDLE=
# Or set the full clickable link directly:
# ZAK_TELEGRAM_URL=https://t.me/zak_meti_26_bot
ZAK_TELEGRAM_URL=
ZAK_TELEGRAM_LABEL=Telegram
# Optional public WhatsApp invite / wa.me link (shown on Telegram / web intros)
# Example: https://wa.me/2347041131371
ZAK_WHATSAPP_URL=
ZAK_WHATSAPP_LABEL=WhatsApp

# Admin web logins & passwords (Name:Phone:Password)
ZAK_ADMIN_LOGINS=
# zak:import-knowledge-chats / zak:seed-assistant-demo use spike DEFAULT_USER_EMAIL + DEFAULT_COMMUNITY_ID when set.
# Future: shared Drive folder Zak polls for program files (same asset_identity dedupe as /asset).
# Not wired yet — use /asset or /asset import until Google OAuth + poll job lands.
# ZAK_DRIVE_SYNC_FOLDER_ID=
# ZAK_DRIVE_SYNC_COMMUNITY_ID=
# ZAK_DRIVE_SYNC_INTERVAL_MINUTES=60
# From Sail containers, reach host-run AI service on port 8001
AI_SERVICE_URL=http://host.docker.internal:8001
API_VERSION=0.1.0

# Shared with ai-service INTERNAL_HMAC_SECRET (must match exactly)
INTERNAL_HMAC_SECRET=prod_secure_hmac_secret_key_minimum_32_bytes_entropy
AI_SERVICE_TIMEOUT=60.0
AI_SERVICE_CONNECT_TIMEOUT=5.0

# WhatsApp Web automation spike (DEV / hackathon ONLY — never enable in production)
WHATSAPP_WEB_SPIKE=false
WHATSAPP_WEB_SPIKE_SECRET=
WHATSAPP_WEB_SPIKE_DEFAULT_USER_EMAIL=demo@zak.test
WHATSAPP_WEB_SPIKE_DEFAULT_COMMUNITY_ID=
# Comma-separated admin phones (digits). Non-admins get a polite denial on admin commands.
WHATSAPP_WEB_SPIKE_ADMIN_PHONES=
# Group mention aliases (comma-separated). Groups listen on mention OR recognized command.
WHATSAPP_WEB_SPIKE_BOT_ALIASES=zak_bot
# Linked WA account number (intl digits, no spaces). Groups that mention this also trigger Zak.
# Example: +234 704 113 1371 → 2347041131371
WHATSAPP_WEB_SPIKE_BOT_NUMBER=2347041131371
# Optional WA @username — store without @; runtime always matches @username as a real mention
# e.g. unipod_bot → listens for @unipod_bot
WHATSAPP_WEB_SPIKE_BOT_USERNAME=unipod_bot
# Optional WA Linked ID (LID). Group @-mentions often use @1006… instead of the phone.
# Spike worker usually learns/sends this automatically; set as fallback if needed.
WHATSAPP_WEB_SPIKE_BOT_LID=
# mention_or_command | private_only
WHATSAPP_WEB_SPIKE_GROUP_LISTEN=mention_or_command
# Spike outbound HTTP so Laravel can DM WhatsApp admins (escalations).
# From Sail: host.docker.internal. From host PHP: http://127.0.0.1:3101
WHATSAPP_WEB_SPIKE_OUTBOUND_URL=http://host.docker.internal:3101

# Telegram Bot spike (DEV / hackathon ONLY — align with Phase 4 later)
TELEGRAM_SPIKE=false
TELEGRAM_SPIKE_SECRET=
TELEGRAM_SPIKE_DEFAULT_USER_EMAIL=demo@zak.test
TELEGRAM_SPIKE_DEFAULT_COMMUNITY_ID=
TELEGRAM_SPIKE_TARGET_LANGUAGE=en
# Same BotFather token as infrastructure/telegram-spike (for admin escalation DMs)
TELEGRAM_SPIKE_BOT_TOKEN=
# Human-facing admin contact (phone for now; configurable, not hardcoded)
TELEGRAM_SPIKE_ADMIN_CONTACT=08117084647
# Telegram chat/user id that receives escalation DMs (required to deliver on Telegram).
# Define each key only once in .env — an earlier empty value wins and blocks notify.
TELEGRAM_SPIKE_ADMIN_CHAT_ID=

# plain (default): strip *bold*/_italic_ so clients never show raw asterisks.
# html: keep emphasis for the spike bot (set TELEGRAM_PARSE_MODE=html there too).
TELEGRAM_SPIKE_FORMATTING=plain

# WhatsApp via Zavu (official BSP → Cloud API). Independent of WA Web / Telegram spikes.
WHATSAPP_ZAVU=false
WHATSAPP_ZAVU_API_KEY=
WHATSAPP_ZAVU_WEBHOOK_SECRET=
WHATSAPP_ZAVU_ADMIN_SECRET=
WHATSAPP_ZAVU_API_BASE=https://api.zavu.dev/v1
WHATSAPP_ZAVU_DEFAULT_USER_EMAIL=demo@zak.test
WHATSAPP_ZAVU_DEFAULT_COMMUNITY_ID=
WHATSAPP_ZAVU_JOIN_TTL_HOURS=72
WHATSAPP_ZAVU_PHONE=
# true = handle inbound in-request (local). Prefer false + queue worker in production.
WHATSAPP_ZAVU_PROCESS_SYNC=false

# Spike inbound: true = sync HTTP reply (default, local DX). false = Laravel Redis queue
# on `channels` + worker sends (Telegram Bot API / WA spike POST /send). Requires:
#   php artisan queue:work redis --queue=channels,ingestion,notifications,default --tries=3
WHATSAPP_WEB_SPIKE_PROCESS_SYNC=true
# false queues free-text /ask; slash commands still reply inline to the spike bot.
TELEGRAM_SPIKE_PROCESS_SYNC=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Laravel Sail Postgres (service name: pgsql)
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=zak
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost

SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1,localhost:3000,127.0.0.1:3000

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# Laravel Sail Redis (service name: redis)
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
