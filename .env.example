# Community Assistant — root Compose defaults.
# Copy to .env for Docker. Keep service-specific secrets in each app's .env.
# PowerShell: Copy-Item .env.example .env

COMPOSE_PROJECT_NAME=community-assistant

POSTGRES_DB=community_assistant
POSTGRES_USER=community
POSTGRES_PASSWORD=community
POSTGRES_PORT=5432

REDIS_PORT=6379

# Public URLs used by local docs and future Compose app services
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
AI_SERVICE_URL=http://localhost:8001
