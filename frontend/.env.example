# Frontend environment. Copy to .env.local for Next.js.
# PowerShell: Copy-Item .env.example .env.local
# Only NEXT_PUBLIC_* values are exposed to the browser. Never put secrets here.
# Production / integrated (same domain as Laravel): leave NEXT_PUBLIC_API_URL empty.
# Build into Laravel public: npm run build:laravel  →  https://your-domain/

NEXT_PUBLIC_APP_NAME=UniPod Community Assistant
# Local `npm run dev` on :3000 calling Sail on :80 only:
# NEXT_PUBLIC_API_URL=http://localhost
NEXT_PUBLIC_API_URL=

# Match backend zak_presence / ZAK_* (sign-in platform chips + parity with /help)
NEXT_PUBLIC_ZAK_WEB_CHAT_LABEL=Web Chat
NEXT_PUBLIC_ZAK_WHATSAPP_LABEL=WhatsApp
NEXT_PUBLIC_ZAK_TELEGRAM_LABEL=Telegram
# Zavu business number as wa.me, e.g. https://wa.me/2348012345678 (must match backend ZAK_WHATSAPP_URL / WHATSAPP_ZAVU_PHONE)
NEXT_PUBLIC_ZAK_WHATSAPP_URL=https://wa.me/2347041131371
NEXT_PUBLIC_ZAK_TELEGRAM_URL=https://t.me/zak_meti_26_bot
